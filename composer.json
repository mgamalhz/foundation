{
    "name": "mgamalhz/foundation",
    "description": "Personal backend foundation for Laravel business platforms: lifecycle state machines, audit additions on spatie/laravel-activitylog, shared support, agent skills.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Gamal",
            "homepage": "https://mgamalhz.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "spatie/laravel-activitylog": "^5.0"
    },
    "suggest": {
        "spatie/laravel-activitylog": "Required for the audit additions (redaction, immutability, transition logging, test assertions)."
    },
    "autoload": {
        "psr-4": {
            "Mgamalhz\\Support\\": "packages/support/src/",
            "Mgamalhz\\Audit\\": "packages/audit/src/",
            "Mgamalhz\\Lifecycle\\": "packages/lifecycle/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mgamalhz\\Support\\Tests\\": "packages/support/tests/",
            "Mgamalhz\\Audit\\Tests\\": "packages/audit/tests/",
            "Mgamalhz\\Lifecycle\\Tests\\": "packages/lifecycle/tests/",
            "Mgamalhz\\Foundation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mgamalhz\\Support\\SupportServiceProvider",
                "Mgamalhz\\Audit\\AuditServiceProvider",
                "Mgamalhz\\Lifecycle\\LifecycleServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
