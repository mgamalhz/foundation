{
    "name": "mgamalhz/support",
    "description": "Shared building blocks for the mgamalhz foundation packages: actor resolution and value normalisation.",
    "keywords": ["laravel", "actor", "audit", "foundation"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Gamal",
            "homepage": "https://mgamalhz.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Mgamalhz\\Support\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mgamalhz\\Support\\SupportServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
