{
    "name": "mgamalhz/audit",
    "description": "One immutable activity log for the whole app: who did what to which record, with redaction and test assertions. Ships an agent skill for Laravel Boost.",
    "keywords": ["laravel", "audit", "audit-log", "activity-log", "boost", "ai"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Gamal",
            "homepage": "https://mgamalhz.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "mgamalhz/support": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Mgamalhz\\Audit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mgamalhz\\Audit\\AuditServiceProvider"
            ],
            "aliases": {
                "Audit": "Mgamalhz\\Audit\\Facades\\Audit"
            }
        }
    },
    "minimum-stability": "stable"
}
